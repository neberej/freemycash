{
  "name": "FreeMyCash.com",
  "version": "0.0.1",
  "description": "Track your finances while owning your data.",
  "keywords": [
    "finance",
    "track"
  ],
  "author": "",
  "license": "ISC",
  "scripts": {
    "dev": "webpack serve",
    "-": "",
    "build": "NODE_ENV=production webpack",
    "serve:ui": "webpack serve --static dist --port 9000",
    "--": "",
    "build:server": "node backend/build-backend.mjs",
    "serve:backend": "yarn kill-port-server && yarn build:server && node backend/dist/server.js",
    "---": "",
    "landing": "webpack serve --config ./landing-page/webpack.config.ts",
    "serve:landing": "webpack serve --config ./landing-page/webpack.config.ts --static dist --port 9001",
    "----": "",
    "test": "jest --silent",
    "coverage": "jest --coverage",
    "kill-port-ui": "lsof -iTCP:3000 -sTCP:LISTEN -n -P | grep node | awk '{print $2}' | xargs -r kill -9",
    "kill-port-landing": "lsof -iTCP:5000 -sTCP:LISTEN -n -P | grep node | awk '{print $2}' | xargs -r kill -9",
    "kill-port-server": "lsof -iTCP:9000 -sTCP:LISTEN -n -P | grep node | awk '{print $2}' | xargs -r kill -9"
  },
  "dependencies": {
    "@testing-library/user-event": "^14.6.1",
    "@types/jest": "^29.5.12",
    "@types/lodash": "^4.17.17",
    "@types/react-router-dom": "^5.3.3",
    "@types/sanitize-html": "^2.16.0",
    "chart.js": "^4.4.9",
    "dotenv": "^16.4.4",
    "eslint-plugin-react": "^7.33.2",
    "express": "^5.1.0",
    "lowdb": "^7.0.1",
    "lucide-react": "^0.511.0",
    "luxon": "^3.6.1",
    "nanoid": "^5.1.5",
    "postcss-loader": "^8.1.0",
    "react": "^18.2.0",
    "react-chartjs-2": "^5.3.0",
    "react-dom": "^18.2.0",
    "react-icons": "^5.5.0",
    "react-paginate": "^8.3.0",
    "react-router-dom": "^6.22.0",
    "react-scroll": "^1.9.3",
    "react-transition-group": "^4.4.5",
    "sanitize-html": "^2.17.0",
    "sass": "^1.89.1",
    "sass-loader": "^16.0.5",
    "zustand": "^5.0.5"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.4.2",
    "@testing-library/react": "^14.2.1",
    "@types/copy-webpack-plugin": "^10.1.0",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/luxon": "^3.6.2",
    "@types/node": "^22.15.29",
